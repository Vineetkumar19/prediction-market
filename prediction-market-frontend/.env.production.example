# ---------------------------------------------------------------------------
# Copy to `.env.production` (or set these as build-time environment variables
# on whatever platform builds this) before running `npm run build` for a real
# deployment.
#
# Vite bakes these into the built JS at BUILD time, not at server start - if
# you change one, you must rebuild, not just restart.
#
# In development the Vite dev server proxies /api and /ws to localhost:8080
# (see vite.config.js), so CORS never comes up locally. In production there is
# no proxy - the browser calls the backend's real URL directly, which is why
# the backend's app.cors.allowed-origins MUST include this frontend's exact
# deployed URL (see application-prod.properties).
# ---------------------------------------------------------------------------

# Your deployed backend's public URL, with https and the /api suffix.
VITE_API_BASE_URL=https://your-backend-url.up.railway.app/api

# Same host, but wss:// and the /ws path - a browser cannot upgrade a
# WebSocket over plain http, and won't upgrade wss over http either.
VITE_WS_URL=wss://your-backend-url.up.railway.app/ws
