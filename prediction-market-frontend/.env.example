# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust.
# Vite only exposes variables that start with VITE_
# ---------------------------------------------------------------------------
#
# There is no VITE_USE_MOCK any more. The in-browser mock backend was removed
# once the real Spring Boot backend arrived - keeping a second copy of the money
# rules in JavaScript only created a way for the two to disagree about who gets
# paid. Start the backend and this app talks to it.

# REST base URL of the Spring Boot backend.
# Leave as /api in development so the Vite proxy handles it (see vite.config.js).
VITE_API_BASE_URL=/api

# WebSocket endpoint of the Spring Boot backend.
# Leave empty in development - the app derives ws(s)://<current-host>/ws automatically.
VITE_WS_URL=
